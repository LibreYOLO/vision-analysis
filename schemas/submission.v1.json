{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionanalysis.org/schemas/submission.v1.json",
  "title": "Vision Analysis Submission v1",
  "type": "object",
  "required": [
    "schema_version",
    "submission_id",
    "created_at",
    "benchmark",
    "model",
    "config",
    "hardware",
    "runtime",
    "accuracy",
    "timing",
    "throughput",
    "model_stats",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "va.submission.v1" },
    "submission_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "benchmark": {
      "type": "object",
      "properties": {
        "harness": { "type": "string" },
        "harness_version": { "type": "string" },
        "libreyolo_version": { "type": "string" },
        "libreyolo_commit": { "type": "string" }
      }
    },
    "repro": {
      "type": "object",
      "description": "Reproducibility provenance (harness >= 2.1.0). Optional for backward compatibility with earlier submissions.",
      "properties": {
        "harness_version": { "type": "string" },
        "harness_commit": { "type": "string" },
        "harness_dirty": { "type": ["boolean", "null"] },
        "command": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "dataset": {
          "type": "object",
          "properties": {
            "image_id_sha256": { "type": "string" },
            "hf_dataset": { "type": "string" },
            "hf_revision": { "type": "string" }
          }
        },
        "weights": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "sha256": { "type": ["string", "null"] },
            "source": { "type": "string" },
            "onnx_opset": { "type": "integer" },
            "export_manifest": { "type": "object" }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "family", "variant", "input_size"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "input_size": { "type": "number" }
      }
    },
    "config": {
      "type": "object",
      "required": ["batch_size", "input_size", "conf", "iou", "max_det"]
    },
    "hardware": {
      "type": "object",
      "required": ["id", "gpu", "cpu", "ram_gb"]
    },
    "runtime": {
      "type": "object",
      "required": ["format", "precision", "provider", "device"]
    },
    "accuracy": { "type": "object" },
    "timing": { "type": "object" },
    "throughput": { "type": "object" },
    "model_stats": { "type": "object" },
    "metadata": { "type": "object" }
  }
}
